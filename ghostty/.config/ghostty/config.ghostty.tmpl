command = /opt/homebrew/bin/fish

theme = {{ghostty_theme}}
background = {{background}}
selection-background = {{selection}}
palette = 0={{black}}
palette = 8={{bright_black}}
palette = 9={{bright_red}}
palette = 10={{bright_green}}
palette = 11={{bright_yellow}}
palette = 12={{bright_blue}}
palette = 13={{bright_magenta}}
palette = 14={{bright_cyan}}
palette = 15={{bright_white}}

window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

macos-titlebar-style = tabs
unfocused-split-opacity = 0.75

font-family = "JetBrainsMono Nerd Font"
font-size = 16
font-thicken = true

mouse-hide-while-typing = true
copy-on-select = clipboard

scrollback-limit = 10000000

clipboard-trim-trailing-spaces = true
window-save-state = always
cursor-click-to-move = true
cursor-style-blink = false

quit-after-last-window-closed = true
confirm-close-surface = false

shell-integration = fish
shell-integration-features = cursor,sudo,title,ssh-terminfo,ssh-env

macos-option-as-alt = true

keybind = ctrl+a>arrow_down=goto_split:down
keybind = ctrl+a>minus=new_split:down
keybind = ctrl+a>arrow_left=goto_split:left
keybind = ctrl+a>arrow_right=goto_split:right
keybind = ctrl+a>backslash=new_split:right
keybind = ctrl+a>arrow_up=goto_split:up

keybind = ctrl+a>c=new_tab

keybind = ctrl+a>n=goto_split:previous
keybind = ctrl+a>p=goto_split:next

keybind = ctrl+a>t=toggle_tab_overview
keybind = ctrl+a>shift+four=prompt_surface_title

keybind = ctrl+a>==equalize_splits
keybind = ctrl+a>x=close_surface
keybind = ctrl+a>z=toggle_split_zoom
