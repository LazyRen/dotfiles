[core]
    # https://github.com/wfxr/forgit/issues/121
    pager = delta --side-by-side --width ${FZF_PREVIEW_COLUMNS-$COLUMNS}

[init]
    defaultBranch = main

[push]
    autoSetupRemote = true

[pull]
    rebase = true

[fetch]
    prune = true

[rebase]
    autoStash = true

[rerere]
    enabled = true

[branch]
    sort = -committerdate

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
    syntax-theme = OneHalfDark

[merge]
    conflictstyle = zdiff3
    tool = codediff

[mergetool "codediff"]
    cmd = nvim "$MERGED" -c "CodeDiff merge \"$MERGED\""

[diff]
    colorMoved = default
    tool = codediff

[difftool "codediff"]
    cmd = nvim "$LOCAL" "$REMOTE" +"CodeDiff file $LOCAL $REMOTE"
